{
  "name": "nialltwomey.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal site of Niall Twomey — publications, projects and notes.",
  "scripts": {
    "publications": "node scripts/build-publications.mjs",
    "prebuild": "npm run publications && npm run content",
    "predev": "npm run publications && npm run content",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check && node scripts/build-publications.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.550.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@retorquere/bibtex-parser": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.5",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "unist-util-visit": "^5.1.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
