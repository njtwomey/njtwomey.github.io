# Build output
dist/
*.local

# Dependencies
node_modules/

# Generated from content/ at build time — never hand-edited, so not committed.
# `make content` (or any build) regenerates them from content/publications.bib
# and content/notes/*.mdx. CI runs the same step before `vite build`, so none of
# this needs to exist in a fresh clone.
src/content/*.json
public/publications-details.json
public/publications.bib

# A note's images and notebooks, copied out of content/notes/<slug>/ so they can
# be served. The originals live beside the prose and are committed; these copies
# are not. `.staging` is the tree a content build assembles before renaming it
# into place, and should only exist if a build died halfway.
public/notes/
public/notes.staging/
public/publications/

# Where PDFs are dropped for the add-publications skill to file. The README
# explains the convention and is committed; papers waiting to be processed are
# working state, and some of them are not public yet.
inbox/*
!inbox/README.md

# Scratch space, for notes to self that are not part of the site.
.scratch/

# Python. uv.lock IS committed — the demos should be reproducible — but the
# resolved environment and bytecode are not.
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.ipynb_checkpoints/

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
npm-debug.log*
